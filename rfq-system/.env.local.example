# Copy this file to .env.local and fill in your values

# Database (SQLite for local, auto-switches to Postgres on Vercel)
DATABASE_URL=file:./data/local.db

# Google Gemini AI (get from: https://aistudio.google.com/apikey)
# Free tier: 1M tokens/day with Gemini 2.0 Flash
GEMINI_API_KEY=

# Resend Email (get from: https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
