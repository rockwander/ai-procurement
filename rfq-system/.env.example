# Database
# Local development: SQLite (file-based)
DATABASE_URL=file:./data/local.db

# Production (Vercel): Will be auto-populated by Vercel Postgres
# DATABASE_URL=postgres://user:pass@host:5432/db

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxx

# Resend Email
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# JWT Authentication
JWT_SECRET=your-super-secret-key-generate-with-crypto-randomBytes

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# File Storage (Auto-detected)
# Local: Uses /public/uploads
# Vercel: Uses Vercel Blob (auto-configured)
# BLOB_READ_WRITE_TOKEN=vercel_blob_xxx  # Auto-populated on Vercel
