# Copy to .env.local and fill in.

# Database — Postgres (Neon). Required.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Google Gemini AI (https://aistudio.google.com/apikey). Required for AI agents.
GEMINI_API_KEY=
# Optional model overrides (defaults shown):
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_MODEL_LITE=gemini-flash-lite-latest
# GEMINI_MODEL_FALLBACK=gemini-2.5-flash

# Resend Email (https://resend.com). Optional — without it, RFQ/reminder/PO
# emails are logged as failed but the workflow continues (form links shown in UI).
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Accept quotations via email (REQUIREMENT_quote-via-email.md).
# Resend "Inbound" — point an inbound address/domain at
#   POST {NEXT_PUBLIC_APP_URL}/api/quote/inbound
# and paste the endpoint's signing secret here. Without it, the webhook rejects
# every request in production (and accepts unsigned requests in development).
RESEND_INBOUND_SECRET=
# The address suppliers reply to (informational; the invitation's From address).
# EMAIL_INBOUND=quotes@yourdomain.com

# JWT Secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# File storage: local /public/uploads in dev, Vercel Blob in prod (auto).
# BLOB_READ_WRITE_TOKEN=  # auto-populated on Vercel
